# Local synthetic demo credentials, not production secrets.
DATABASE_URL=postgres:///ai_buddy?host=/tmp
APP_MODE=demo
TEST_DATABASE_URL=postgres:///ai_buddy_test?host=/tmp
APP_ADDR=127.0.0.1:8090
CORPORATE_ADDR=127.0.0.1:8091
CORPORATE_BASE_URL=http://127.0.0.1:8091
CORPORATE_TOKEN=local-demo-service
DEMO_OPERATOR_TOKEN=local-demo-owner
MODEL_PROVIDER=ollama
MODEL_BASE_URL=http://127.0.0.1:11434
MODEL_NAME=qwen3.5:4b
# CPU container may keep the model loaded for at most 300 seconds; native defaults unload.
MODEL_CPU_ONLY=false
MODEL_KEEP_ALIVE_SECONDS=0
# Optional local semantic search; without it, BM25 remains available.
EMBEDDING_MODEL=embeddinggemma:300m
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_VERSION=85462619ee721b466c5927d109d4cb765861907d5417b9109caebc4e614679f1
EMBEDDING_CACHE_FILE=tmp/embedding-index.json
# Optional path to the official Ollama binary when it is not in PATH.
OLLAMA_BIN=ollama
OLLAMA_MIN_FREE_MEMORY_PERCENT=25
MODEL_API_KEY=
ALLOW_EXTERNAL_MODEL=false
MODEL_DATA_POLICY=internal
SECURE_COOKIE=false
WEB_DIR=web/dist
